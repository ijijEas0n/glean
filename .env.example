# 复制成 .env 后自行填写。不要把 Key 发到聊天、Issue 或 PR。
# ./启动.sh 会加载这个文件。也可以留空，改在网页「设置」里填
# （写入 ~/.glean/config.json，可用 GLEAN_CONFIG_DIR 改目录）。
# 读取顺序：环境变量优先于网页设置。留空表示未设置，启动脚本不会写回任何值。

# 必需。TikHub Token，抖音 / 小红书抓取都靠它。没有它不能抓取。
TIKHUB_API_KEY=

# 云转写 Key 按所选引擎填写，不必两个都填。
# 默认引擎是火山「大模型录音文件极速版」（transcribe_engine=volcengine）时填写。
VOLCENGINE_ASR_API_KEY=

# 选择阿里云百炼（transcribe_engine=aliyun）时填写。
# 必须是华北 2（北京）地域的 Key；其他地域不能用。
# 选本机 whisper，或把转写关掉（transcribe_engine=off）时留空。
DASHSCOPE_API_KEY=

# 可选。本机 faster-whisper 的 Python 路径。
# 装在 ~/.glean/faster-whisper 时可以留空，会被自动发现。
GLEAN_WHISPER_PYTHON=

# 可选。本地库目录，默认是仓库下的 library。
GLEAN_LIBRARY_DIR=

# 可选。配置目录，默认是 ~/.glean。
GLEAN_CONFIG_DIR=

# 可选。启动脚本使用的 Python，默认 python3，需要 3.11+。
GLEAN_PYTHON=

# 可选。本机 whisper 模型：base、small 或 medium，默认 small。
GLEAN_WHISPER_MODEL=

# 可选。低粉爆款候选筛选开关，0 / false / off 关闭，默认开启。
GLEAN_VIRAL_ENABLED=1
# 分平台门槛、关键词、TikHub path 在网页配置 API 的 viral 对象中设置：
# POST /api/config {"viral":{"douyin":{"max_fans":50000,"min_interactions":10000,
# "min_multiplier":3,"max_age_days":14,"keywords":["AI"]},"xiaohongshu":{
# "max_fans":10000,"min_interactions":1000,"min_multiplier":1,"max_age_days":14}}}
# 完整默认值与 path 覆盖见 SPEC.md。预览会调用 TikHub，可能计费，但不下载/转写。
